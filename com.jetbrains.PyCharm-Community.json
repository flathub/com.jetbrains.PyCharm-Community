{
  "id": "com.jetbrains.PyCharm-Community",
  "runtime": "org.freedesktop.Sdk",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "pycharm-wrapper",
  "finish-args": [
    "--device=dri",
    "--filesystem=home",
    "--share=ipc",
    "--share=network",
    "--socket=ssh-auth",
    "--socket=gpg-agent",
    "--socket=fallback-x11",
    "--socket=wayland"
  ],
  "modules": [
    "python3-modules.json",
    {
      "name": "pycharm",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a pycharm-*/* ${FLATPAK_DEST}",
        "cat idea.properties >> ${FLATPAK_DEST}/bin/idea.properties",
        "install -D -t ${FLATPAK_DEST}/bin/ pycharm-wrapper",
        "install -Dm644 -t ${FLATPAK_DEST}/share/metainfo/ ${FLATPAK_ID}.metainfo.xml",
        "install -Dm644 -t ${FLATPAK_DEST}/share/applications/ ${FLATPAK_ID}.desktop",
        "install -Dm644 -t ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/ ${FLATPAK_ID}.svg"
      ],
      "sources": [
        {
          "type": "archive",
          "strip-components": 0,
          "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm/2026.2.5/pycharm-2026.2.5.tar.gz",
          "sha256": "cc8bbb4fa6c331cfbec372c9289e5599c93d45e8ba59588fe902de54d3e59fd7",
          "only-arches": [
            "x86_64"
          ],
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/JetBrains/intellij-community/releases",
            "version-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).tag_name | sub(\"^pycharm/\"; \"\")",
            "url-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).assets[] | select(.name==\"pycharm-\" + $version + \".tar.gz\") | .browser_download_url",
            "is-main-source": true
          }
        },
        {
          "type": "archive",
          "strip-components": 0,
          "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm/2026.2.5/pycharm-2026.2.5-aarch64.tar.gz",
          "sha256": "7b68e101209b5a86952c1c3bf1d7f6ad7c8420c6a16919bf4ae853aaf24e3f25",
          "only-arches": [
            "aarch64"
          ],
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/JetBrains/intellij-community/releases",
            "version-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).tag_name | sub(\"^pycharm/\"; \"\")",
            "url-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).assets[] | select(.name==\"pycharm-\" + $version + \"-aarch64.tar.gz\") | .browser_download_url",
            "is-main-source": true
          }
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Community.metainfo.xml"
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Community.desktop"
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Community.svg"
        },
        {
          "type": "file",
          "path": "idea.properties"
        },
        {
          "type": "script",
          "dest-filename": "pycharm-wrapper",
          "commands": [
            "/app/bin/pycharm $@"
          ]
        }
      ]
    },
    {
      "name": "dbus",
      "buildsystem": "meson",
      "config-opts": [
        "-Dtools=true",
        "-Dmessage_bus=false",
        "-Dsystemd=disabled",
        "-Dx11_autolaunch=disabled"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://dbus.freedesktop.org/releases/dbus/dbus-1.16.4.tar.xz",
          "sha256": "d08b05526c2cb7966a5fb79210d6112b1aca3d135f315c1b302e14b4b0297dac",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 5356,
            "stable-only": true,
            "url-template": "https://dbus.freedesktop.org/releases/dbus/dbus-$version.tar.xz"
          }
        }
      ]
    }
  ]
}
