{
  "id": "com.jetbrains.PyCharm-Community",
  "runtime": "org.freedesktop.Sdk",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "pycharm-wrapper",
  "finish-args": [
    "--device=dri",
    "--filesystem=home",
    "--share=ipc",
    "--share=network",
    "--socket=ssh-auth",
    "--socket=gpg-agent",
    "--socket=fallback-x11",
    "--socket=wayland"
  ],
  "modules": [
    "python3-requirements.json",
    {
      "name": "pycharm",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a pycharm-*/* ${FLATPAK_DEST}",
        "cat idea.properties >> ${FLATPAK_DEST}/bin/idea.properties",
        "install -D -t ${FLATPAK_DEST}/bin/ pycharm-wrapper",
        "install -Dm644 -t ${FLATPAK_DEST}/share/metainfo/ ${FLATPAK_ID}.metainfo.xml",
        "install -Dm644 -t ${FLATPAK_DEST}/share/applications/ ${FLATPAK_ID}.desktop",
        "install -Dm644 -t ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/ ${FLATPAK_ID}.svg"
      ],
      "sources": [
        {
          "type": "archive",
          "strip-components": 0,
          "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm%2F2026.3/pycharm-2026.3.tar.gz",
          "sha256": "5c26292b328e45a259a96e94f3b1c03fc78b78ab5c238a4c7f70114f493e8864",
          "only-arches": [
            "x86_64"
          ],
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/JetBrains/intellij-community/releases",
            "version-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).tag_name | sub(\"^pycharm/\"; \"\")",
            "url-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).assets[] | select(.name==\"pycharm-\" + $version + \".tar.gz\") | .browser_download_url",
            "is-main-source": true
          }
        },
        {
          "type": "archive",
          "strip-components": 0,
          "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm%2F2026.3/pycharm-2026.3-aarch64.tar.gz",
          "sha256": "46b8518432b7633237e7f864c2a11ca9b05cb16b10638cb70129f5001274954f",
          "only-arches": [
            "aarch64"
          ],
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/JetBrains/intellij-community/releases",
            "version-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).tag_name | sub(\"^pycharm/\"; \"\")",
            "url-query": "first(.[] | select(.tag_name | test(\"^pycharm/\"))).assets[] | select(.name==\"pycharm-\" + $version + \"-aarch64.tar.gz\") | .browser_download_url",
            "is-main-source": true
          }
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Community.metainfo.xml"
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Community.desktop"
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Community.svg"
        },
        {
          "type": "file",
          "path": "idea.properties"
        },
        {
          "type": "script",
          "dest-filename": "pycharm-wrapper",
          "commands": [
            "/app/bin/pycharm $@"
          ]
        }
      ]
    },
    {
      "name": "dbus",
      "buildsystem": "meson",
      "config-opts": [
        "-Dtools=true",
        "-Dmessage_bus=false",
        "-Dsystemd=disabled",
        "-Dx11_autolaunch=disabled"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz",
          "sha256": "0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 5356,
            "stable-only": true,
            "url-template": "https://dbus.freedesktop.org/releases/dbus/dbus-$version.tar.xz"
          }
        }
      ]
    }
  ]
}
